{
  "name": "@redact-secret/vault-server",
  "version": "0.1.0-beta.1",
  "description": "Server authority (principal, tenant, source, sink/path, purpose) for restoring values captured by @redact-secret/vault, with an in-memory storage backend.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@redact-secret/vault": "0.1.0-beta.1"
  },
  "peerDependencies": {
    "@redact-secret/core": "0.1.0-beta.10"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-vault.git",
    "directory": "packages/vault-server"
  },
  "bugs": {
    "url": "https://github.com/redact-secret/redact-secret-vault/issues"
  },
  "homepage": "https://github.com/redact-secret/redact-secret-vault/tree/main/packages/vault-server#readme",
  "keywords": [
    "redaction",
    "secrets",
    "llm",
    "vault",
    "authorization"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  }
}
