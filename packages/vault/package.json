{
  "name": "@redact-secret/vault",
  "version": "0.1.0-alpha.3",
  "description": "Opt-in, bounded, in-memory vault that restores values redacted by @redact-secret/core into application-designated fields.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker-client.d.ts",
      "import": "./dist/worker-client.js"
    },
    "./worker/host": {
      "types": "./dist/worker-host.d.ts",
      "import": "./dist/worker-host.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@redact-secret/core": "0.1.0-beta.10"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-vault.git",
    "directory": "packages/vault"
  },
  "bugs": {
    "url": "https://github.com/redact-secret/redact-secret-vault/issues"
  },
  "homepage": "https://github.com/redact-secret/redact-secret-vault/tree/main/packages/vault#readme",
  "keywords": [
    "redaction",
    "secrets",
    "llm",
    "vault"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/capture-output.test.mjs test/pii.test.mjs test/pii-core.test.mjs test/worker-pii.test.mjs test/worker-pii-core.test.mjs"
  }
}
