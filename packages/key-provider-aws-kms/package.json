{
  "name": "@redact-secret/key-provider-aws-kms",
  "version": "0.1.0-alpha.1",
  "description": "Optional AWS KMS key provider for the persistent Redact Secret vault: envelope data keys generated, unwrapped, and re-wrapped by a consumer-supplied KMS client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@redact-secret/vault-contracts": "0.1.0-alpha.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-kms": "^3"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-vault.git",
    "directory": "packages/key-provider-aws-kms"
  },
  "bugs": {
    "url": "https://github.com/redact-secret/redact-secret-vault/issues"
  },
  "homepage": "https://github.com/redact-secret/redact-secret-vault/tree/main/packages/key-provider-aws-kms#readme",
  "keywords": [
    "redaction",
    "secrets",
    "vault",
    "aws-kms",
    "envelope-encryption"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "devDependencies": {
    "@aws-sdk/client-kms": "3.1144.0",
    "@redact-secret/vault-conformance": "0.1.0-alpha.1",
    "@redact-secret/vault-crypto": "0.1.0-alpha.1"
  }
}
