{
  "name": "@redact-secret/vault-conformance",
  "version": "0.1.0-alpha.1",
  "description": "Runner-agnostic conformance harnesses for persistent Redact Secret vault Store and KeyProvider implementations, with a transaction oracle, fault injection, and an insecure deterministic test key provider.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@redact-secret/vault-contracts": "0.1.0-alpha.1"
  },
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redact-secret/redact-secret-vault.git",
    "directory": "packages/vault-conformance"
  },
  "bugs": {
    "url": "https://github.com/redact-secret/redact-secret-vault/issues"
  },
  "homepage": "https://github.com/redact-secret/redact-secret-vault/tree/main/packages/vault-conformance#readme",
  "keywords": [
    "redaction",
    "secrets",
    "vault",
    "conformance",
    "testing"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  }
}
